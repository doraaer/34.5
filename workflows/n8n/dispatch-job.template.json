{
  "id": "doraDispatch0001",
  "name": "DORA – Partner Dispatch",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "dora-dispatch",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1f0c001-0000-4000-8000-000000000001",
      "name": "Dispatch Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "webhookId": "5d0ea000-d15b-4a7c-8000-000000000001",
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "DORA Internal Token"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Validate the work order sent by the DORA backend. Pure check, no storage.\nconst body = $input.first().json.body ?? {};\nconst isText = (v) => typeof v === 'string' && v.trim() !== '';\nconst missing = [];\nfor (const f of ['case_id', 'description', 'location']) {\n  if (!isText(body[f])) missing.push(f);\n}\nconst slots = Array.isArray(body.available_slots) ? body.available_slots : [];\nconst goodSlots = slots.length > 0 && slots.every((s) => s && isText(s.start) && isText(s.end));\nif (!goodSlots) missing.push('available_slots');\nif (missing.length) {\n  return [{ json: { valid: false, error: 'missing or invalid field(s): ' + missing.join(', ') } }];\n}\n// Partner body = same fields without idempotency_key (partner dedupes on case_id).\nreturn [{ json: { valid: true, partner_request: {\n  case_id: body.case_id,\n  service_type: body.service_type ?? 'heating_repair',\n  description: body.description,\n  location: body.location,\n  available_slots: slots,\n} } }];"
      },
      "id": "a1f0c001-0000-4000-8000-000000000002",
      "name": "Validate Work Order",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c0000001-0000-4000-8000-000000000001",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1f0c001-0000-4000-8000-000000000003",
      "name": "Is Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"error\": $json.error } }}",
        "options": {
          "responseCode": 400
        }
      },
      "id": "a1f0c001-0000-4000-8000-000000000004",
      "name": "Respond 400",
      "type": "n8n-nodes-base.respondToWebhook",
