        "method": "POST",
        "url": "={{ ($env.DORA_PARTNER_BASE_URL || 'http://127.0.0.1:8000').replace(/\\/$/, '') }}/partner/jobs",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.partner_request) }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "a1f0c001-0000-4000-8000-000000000005",
      "name": "POST Partner Job",
