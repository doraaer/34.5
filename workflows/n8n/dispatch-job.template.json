    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c0000002-0000-4000-8000-000000000001",
              "leftValue": "={{ $json.partner_job_id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            },
            {
              "id": "c0000002-0000-4000-8000-000000000002",
              "leftValue": "={{ $json.case_id }}",
              "rightValue": "={{ $('Validate Work Order').first().json.partner_request.case_id }}",
              "operator": {
