DORA_DB_PATH=./dora.sqlite
ELEVENLABS_AGENT_ID=
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
N8N_WEBHOOK_URL=
DORA_INTERNAL_TOKEN=replace-before-public-deployment
APP_BASE_URL=http://127.0.0.1:8000

# Tenant calendar for DORA slot proposals (POST /api/cases/{id}/calendar-proposal)
# fake   = SIMULATED calendar read from a JSON file of busy blocks (demo default)
# google = Google Calendar FreeBusy (read-only busy times); needs a short-lived token. Not connected by default.
# unset  = endpoint answers 409 "calendar not connected" and DORA falls back to partner windows
DORA_CALENDAR_PROVIDER=fake
DORA_FAKE_CALENDAR_FILE=./data/demo/tenant-calendar-busy.json
DORA_GOOGLE_CALENDAR_ACCESS_TOKEN=
DORA_GOOGLE_CALENDAR_ID=primary
